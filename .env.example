# ==============================================================================
# KAUAN GABRIEL PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANTE:
# 1. Copie este arquivo para ".env" ou ".env.local" para configurar em sua máquina ou na Vercel.
# 2. O arquivo ".env" real já está protegido no ".gitignore" e NUNCA será commitado no Git.
# 3. No Vite, variáveis com prefixo "VITE_" são públicas e incorporadas ao bundle do navegador.
#    Portanto, NUNCA coloque chaves secretas (OpenAI, Resend, Stripe, tokens de banco) com "VITE_".
# ==============================================================================

# 1. Identificadores Públicos de Rastreamento (Client-Side / Browser)
# (Estes IDs são públicos e carregam de forma diferida após a primeira interação)
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# 2. Verificação do Google Search Console (Meta Tag)
VITE_GOOGLE_SITE_VERIFICATION=

# 3. Chaves de API Secretas (Server-Side / Backend Only)
# (Devem ser configuradas apenas nas Environment Variables da Vercel ou em funções /api)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
